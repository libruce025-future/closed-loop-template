{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(docker build *)",
      "Bash(docker compose config*)",
      "Bash(curl -fsS http://127.0.0.1*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Read(./deploy/app.env)",
      "Read(./deploy/deploy.env)",
      "Edit(./deploy/app.env)",
      "Edit(./deploy/deploy.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/guard-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
