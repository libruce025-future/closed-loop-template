# Copy to /opt/closed-loop/deploy.env on the ECS host (chmod 600, root-owned).
# Used by docker compose for variable substitution only.

# Alibaba Cloud ACR (or ghcr.io / any registry)
IMAGE_REGISTRY=registry.cn-hangzhou.aliyuncs.com
IMAGE_REPO=your-namespace/closed-loop-template
# Overridden per deploy by deploy-remote.sh; kept here for `docker compose config`.
IMAGE_TAG=dev

# Public domain for automatic HTTPS via Caddy.
# For IP-only testing set DOMAIN=:80 (plain HTTP).
DOMAIN=example.com
