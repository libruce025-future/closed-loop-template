#!/usr/bin/env bash
# Root-owned sudo wrapper. Only these verbs are allowed.
set -Eeuo pipefail

BASE="${APP_BASE:-/opt/closed-loop}"

case "${1:-}" in
  deploy)
    [[ $# -eq 2 ]] || { echo "usage: deploy-ctl deploy <40-hex-sha>" >&2; exit 64; }
    exec bash "$BASE/scripts/deploy-remote.sh" "$2"
    ;;
  rollback)
    [[ $# -eq 1 ]] || { echo "usage: deploy-ctl rollback" >&2; exit 64; }
    exec bash "$BASE/scripts/deploy-remote.sh" --rollback
    ;;
  status)
    echo "current: $(readlink -f "$BASE/current" 2>/dev/null || echo none)"
    echo "releases:"
    ls -1 "$BASE/releases" 2>/dev/null | tail -10
    ;;
  *)
    echo "usage: deploy-ctl {deploy <40-hex-sha>|rollback|status}" >&2
    exit 64
    ;;
esac
